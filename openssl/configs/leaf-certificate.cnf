[ req ]
default_bits        = 2048
default_md          = sha256
prompt              = no
distinguished_name  = certificate_dn
string_mask         = utf8only

[ certificate_dn ]
countryName             = "${country}"
stateOrProvinceName     = "${state}"
localityName            = "${locality}"
organizationName        = "${organization}"
organizationalUnitName  = "${organizational_unit}"
commonName              = "${common_name}"
emailAddress            = ""
